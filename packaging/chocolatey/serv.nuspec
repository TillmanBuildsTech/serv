  <metadata>
    <id>serv</id>
    <version>0.1.9</version>
    <title>serv</title>
    <authors>TillmanBuildsTech</authors>
    <owners>TillmanBuildsTech</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/TillmanBuildsTech/serv</projectUrl>
    <projectSourceUrl>https://github.com/TillmanBuildsTech/serv</projectSourceUrl>
